<launch>
  <arg name="static" default="false"/>

  <!-- In static mode the two fixed transforms replace frames_publisher_node. -->
  <group if="$(arg static)">
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="av1broadcaster" args="1 0 0 0 0 0 1 world av1"/>
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="av2broadcaster" args="0 0 1 0 0 0 1 world av2"/>
  </group>

  <!-- In dynamic mode this node publishes world -> av1 and world -> av2. -->
  <node name="frames_publisher_node" pkg="two_drones_pkg"
        type="frames_publisher_node" unless="$(arg static)"/>

  <!-- Meshes and all three trajectory trails are published on /visuals. -->
  <node name="plots_publisher_node" pkg="two_drones_pkg"
        type="plots_publisher_node"/>

  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find two_drones_pkg)/config/default.rviz"/>
</launch>
