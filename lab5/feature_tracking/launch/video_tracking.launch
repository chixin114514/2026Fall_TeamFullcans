<launch>
  <!-- (OPTIONAL) Put in the path to the dataset as a default value for the argument -->
  <arg name="path_to_dataset" />
  <arg name="descriptor" default="SIFT" />
  <arg name="rate" default="1.0" />
  <arg name="window_width" default="1600" />
  <arg name="window_height" default="900" />
  <arg name="enter_only" default="false" />
  <!-- Optional outputs (empty = disabled): per-frame statistics and frame dumps -->
  <arg name="stats_csv" default="" />
  <arg name="frames_dir" default="" />

  <node name="lab_5" pkg="lab_5" type="track_features" output="screen" required="true">
    <param name="window_width" type="int" value="$(arg window_width)" />
    <param name="window_height" type="int" value="$(arg window_height)" />
    <param name="enter_only" type="bool" value="$(arg enter_only)" />
    <param name="img1_path" type="string" value="$(find lab_5)/images/box.png"/>
    <param name="img2_path" type="string" value="$(find lab_5)/images/box_in_scene.png"/>
    <param name="mode" type="int" value="1"/>
    <param name="descriptor" type="string" value="$(arg descriptor)"/>
    <param name="stats_csv" type="string" value="$(arg stats_csv)"/>
    <param name="frames_dir" type="string" value="$(arg frames_dir)"/>
    <!-- Parameters used for the Deliverable 6.b tables -->
    <param name="orb_nfeatures" type="int" value="1000"/>
    <param name="orb_nlevels" type="int" value="8"/>
    <param name="fast_threshold" type="int" value="20"/>

    <remap from="/images_topic" to="/camera/color/image_raw"/>
  </node>
  <!-- required: when the bag ends everything shuts down and the node prints its averages -->
  <node name="rosbag" pkg="rosbag" type="play" output="screen" required="true"
  args="--quiet --clock -r $(arg rate) $(arg path_to_dataset)  /tesse/left_cam/rgb/image_raw:=/camera/color/image_raw" />
</launch>
