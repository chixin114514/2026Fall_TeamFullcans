<launch>
  <arg name="descriptor" default="SIFT" />
  <!-- If set, all figures are also written to this directory -->
  <arg name="output_dir" default="" />
  <!-- 0 keeps the interactive keypress behavior; positive values auto-advance. -->
  <arg name="display_delay_ms" default="0" />
  <arg name="window_width" default="1600" />
  <arg name="window_height" default="900" />
  <arg name="enter_only" default="false" />
  <arg name="terminal_enter" default="false" />

  <!-- End roslaunch after the image demo so the next scripted stage can start. -->
  <node name="lab_5" pkg="lab_5" type="track_features" output="screen" required="true">
    <param name="img1_path" type="string" value="$(find lab_5)/images/box.png"/>
    <param name="img2_path" type="string" value="$(find lab_5)/images/box_in_scene.png"/>
    <param name="mode" type="int" value="0"/>
    <param name="descriptor" type="string" value="$(arg descriptor)" />
    <param name="output_dir" type="string" value="$(arg output_dir)" />
    <param name="display_delay_ms" type="int" value="$(arg display_delay_ms)" />
    <param name="window_width" type="int" value="$(arg window_width)" />
    <param name="window_height" type="int" value="$(arg window_height)" />
    <param name="enter_only" type="bool" value="$(arg enter_only)" />
    <param name="terminal_enter" type="bool" value="$(arg terminal_enter)" />
  </node>
</launch>
